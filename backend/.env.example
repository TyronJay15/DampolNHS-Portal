SECRET_KEY=dev-only-change-me-use-a-long-random-string-32b
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
DB_NAME=dampol_portal
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Sign-in sessions (security plan): access token minutes, idle minutes, hard limit in hours.
AUTH_ACCESS_MINUTES=15
AUTH_IDLE_MINUTES=30
AUTH_SESSION_HOURS=12
# Lax when the frontend and API share a site; None only when truly cross-site (HTTPS only). See README.
AUTH_COOKIE_SAMESITE=Lax
RECAPTCHA_SECRET_KEY=
FRONTEND_URL=http://localhost:5173
# Brevo SMTP. Password and login stay in this file, never in the frontend.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_FROM_NAME=Dampol 1st NHS
MAIL_PRINT_CODES=true
# Registration emails: "inline" sends right away (local use). "background" needs `manage.py send_outbox`.
MAIL_DELIVERY=inline
MAIL_DAILY_LIMIT=300
MAIL_CODE_RESERVE=50
MAIL_KEEP_DAYS=30
# Demo database for the defence only. Never true on the real school server.
DEMO_MODE=false
# Gemini key stays on the API only. Never put this in frontend env.
GEMINI_API_KEY=
# Interest answers and saved recommendations for graduates, days after their last school year ended.
GUIDANCE_KEEP_DAYS=365

# Production (Railway variables, never committed). Names only; see README "Production (Railway)".
# DEBUG=false
# SECRET_KEY=                     at least 50 random characters
# ALLOWED_HOSTS=                  the API hostname
# FRONTEND_URL=                   https:// address of the frontend
# CORS_ALLOWED_ORIGINS=           the same frontend address
# CSRF_TRUSTED_ORIGINS=           the same frontend address
# NUM_PROXIES=1                  required: rate limits must see the real visitor address
# AUTH_COOKIE_SAMESITE=Lax        see README "Sign-in cookies"
# MAIL_TRANSPORT=brevo_api        Railway Hobby blocks SMTP
# BREVO_API_KEY=
# DEFAULT_FROM_EMAIL=
# MAIL_DELIVERY=background
# MAIL_PRINT_CODES=false
# RECAPTCHA_SECRET_KEY=           required when DEBUG is false
# MEDIA_ROOT=                     the volume mount path for uploaded photos
# DJANGO_ADMIN_PATH=              a hard-to-guess path, or off
# SECURE_HSTS_SECONDS=3600
# DEMO_MODE=false
